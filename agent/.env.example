# Everything is auto-detected from your local machine.
# This file is only needed if you want to override defaults or add email support.

# === Auto-detected (override only if needed) ===

# GitHub token — auto-detected from `gh auth token`
# GITHUB_PAT=ghp_xxxxxxxxxxxx

# Repo owner/name — auto-detected from `git remote get-url origin`
# GITHUB_OWNER=itayshmool
# GITHUB_REPO=from-dev-basics-to-claude-code

# ANTHROPIC_API_KEY — not needed, Claude Code Agent SDK uses your local auth

# === Optional (for email notifications) ===

# Resend — for emailing bug reporters + admin digest
# Without this, agent works fine but skips all email notifications
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=From Zero to Claude Code <triage@zero2claude.dev>

# Admin email — receives a summary digest after each triage cycle
# ADMIN_EMAIL=your-email@example.com

# === Defaults ===

# DRY_RUN=false
# PROJECT_ROOT=/path/to/repo
# LOG_DIR=/path/to/repo/agent/logs
